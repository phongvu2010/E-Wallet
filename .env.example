# App Configuration
PROJECT_NAME="Personal Finance API"
ENVIRONMENT="development" # Options: development, staging, production
API_V1_STR="/api/v1"

# Database Configuration (Supabase PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres"

# Supabase Auth / JWT Configuration
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET" # Lấy tại Supabase Dashboard -> Project Settings -> API (JWT Secret)
SUPABASE_JWT_AUDIENCE="authenticated" # Mặc định của Supabase Auth là 'authenticated'
ALGORITHM="HS256"

# CORS Configuration (Format: JSON Array hoặc chuỗi phân cách bởi dấu phẩy)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'

